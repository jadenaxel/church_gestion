NODE_ENV=development
# PostgreSQL local aislado; use secretos administrados y TLS en producción.
# Producción: CONTROL_DATABASE_URL con login no administrativo; configure un login
# TENANT_DATABASE_USER distinto por servicio, miembro únicamente de su gc_*_service.
# Configure TLS con verificación de certificado (PGSSLMODE=verify-full y CA confiable).
# El runtime productivo rechaza SUPERUSER/CREATEDB/CREATEROLE/BYPASSRLS y conexiones sin TLS.
CONTROL_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/gestionchurch_control
POSTGRES_ADMIN_URL=postgresql://postgres@127.0.0.1:55432/postgres
TENANT_DATABASE_HOST=127.0.0.1
TENANT_DATABASE_PORT=55432
TENANT_DATABASE_USER=postgres
TENANT_DATABASE_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_SECRET=replace-with-another-random-secret
WEB_ORIGIN=http://localhost:3000
BASE_DOMAIN=gestionchurch.com
GATEWAY_PORT=4000
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=240
IDENTITY_SERVICE_URL=http://127.0.0.1:4011
TENANT_SERVICE_URL=http://127.0.0.1:4012
CALENDAR_SERVICE_URL=http://127.0.0.1:4013
FILE_SERVICE_URL=http://127.0.0.1:4014
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4015
REPORTS_SERVICE_URL=http://127.0.0.1:4016
ELDERS_SERVICE_URL=http://127.0.0.1:4017
PERSONAL_MINISTRIES_SERVICE_URL=http://127.0.0.1:4018
WOMENS_MINISTRY_SERVICE_URL=http://127.0.0.1:4019
DEPARTMENT_OPERATIONS_SERVICE_URL=http://127.0.0.1:4020
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NOMINATIONS_WEB_URL=http://localhost:3300
# Debe ser el mismo secreto aleatorio configurado en el API de Nombramientos.
NOMINATIONS_INTEGRATION_SECRET=replace-with-a-separate-random-integration-secret
UPLOAD_ROOT=.local/uploads
MAX_UPLOAD_BYTES=15728640
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Production SMTP targets must be public. Exact host allowlist for a deliberately private mail relay:
SMTP_PRIVATE_HOST_ALLOWLIST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GestionChurch <no-reply@gestionchurch.local>
# Obligatoria en producción: secreto aleatorio estable de al menos 32 caracteres, suministrado por el secret manager.
CONFIG_ENCRYPTION_KEY=
# En producción debe ser la URL HTTPS pública del gateway; Meta no puede usar localhost ni redes privadas.
PUBLIC_API_URL=http://localhost:4000/api/v1
WHATSAPP_MODE=simulated
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
META_GRAPH_VERSION=v23.0
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=gestionchurch
S3_SECRET_KEY=gestionchurch-local-only
S3_BUCKET=gestionchurch-programs
CLAMAV_HOST=
CLAMAV_PORT=3310
REDIS_URL=redis://127.0.0.1:56379
NATS_URL=nats://127.0.0.1:54222
OTEL_EXPORTER_OTLP_ENDPOINT=
# No se permite generar backups sin una frase de al menos 16 caracteres.
GC_BACKUP_PASSPHRASE=
